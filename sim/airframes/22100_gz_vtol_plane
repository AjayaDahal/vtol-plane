#!/bin/sh
#
# @name VTOL plane (3-D printed tilt-rotor tricopter)
#
# @type VTOL Tiltrotor
#
# @maintainer AjayaDahal/vtol-plane
#
# Generated by scripts/make_sim.py from the design; do not edit. The actuator geometry and
# outputs are PX4_GUIDE.md's, with SIM_GZ_* in place of the PWM/DShot outputs.
#

. ${R}etc/init.d/rc.vtol_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=vtol_field}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=vtol_plane}

param set-default SIM_GZ_EN 1
param set-default MAV_TYPE 21
param set-default VT_TYPE 1
param set-default CA_AIRFRAME 3

# Rotors relative to the hover CG, x forward, y right (PX4_GUIDE.md, Geometry)
param set-default CA_ROTOR_COUNT 3
param set-default CA_ROTOR0_PX 0.123
param set-default CA_ROTOR0_PY 0.280
param set-default CA_ROTOR0_KM -0.05
param set-default CA_ROTOR0_TILT 1
param set-default CA_ROTOR1_PX 0.123
param set-default CA_ROTOR1_PY -0.280
param set-default CA_ROTOR1_KM 0.05
param set-default CA_ROTOR1_TILT 2
param set-default CA_ROTOR2_PX -0.342
param set-default CA_ROTOR2_PY 0.000
param set-default CA_ROTOR2_KM 0.05

# Tilt servos: 0 deg = thrust up, -20 (back) to 90 (forward), used for yaw
param set-default CA_SV_TL_COUNT 2
param set-default CA_SV_TL0_MINA -20
param set-default CA_SV_TL0_MAXA 90
param set-default CA_SV_TL0_TD 0
param set-default CA_SV_TL0_CT 1
param set-default CA_SV_TL1_MINA -20
param set-default CA_SV_TL1_MAXA 90
param set-default CA_SV_TL1_TD 0
param set-default CA_SV_TL1_CT 1

# Control surfaces: right aileron mid, tip; left mid, tip; right, left ruddervator
param set-default CA_SV_CS_COUNT 6
param set-default CA_SV_CS0_TYPE 2
param set-default CA_SV_CS0_TRQ_R 0.25
param set-default CA_SV_CS1_TYPE 2
param set-default CA_SV_CS1_TRQ_R 0.25
param set-default CA_SV_CS2_TYPE 1
param set-default CA_SV_CS2_TRQ_R -0.25
param set-default CA_SV_CS3_TYPE 1
param set-default CA_SV_CS3_TRQ_R -0.25
param set-default CA_SV_CS4_TYPE 8
param set-default CA_SV_CS4_TRQ_P 0.5
param set-default CA_SV_CS4_TRQ_Y -0.5
param set-default CA_SV_CS5_TYPE 7
param set-default CA_SV_CS5_TRQ_P 0.5
param set-default CA_SV_CS5_TRQ_Y 0.5

# Outputs: ESC 1-3 = PX4_GUIDE.md's AUX1-3; servo 1-8 = its MAIN1-8 (gz servo_0-7)
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_MIN1 110
param set-default SIM_GZ_EC_MAX1 2200
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_MIN2 110
param set-default SIM_GZ_EC_MAX2 2200
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_MIN3 110
param set-default SIM_GZ_EC_MAX3 2200
param set-default SIM_GZ_SV_FUNC1 207
param set-default SIM_GZ_SV_MINA1 -20
param set-default SIM_GZ_SV_MAXA1 90
param set-default SIM_GZ_SV_DIS1 182
param set-default SIM_GZ_SV_FUNC2 208
param set-default SIM_GZ_SV_MINA2 -20
param set-default SIM_GZ_SV_MAXA2 90
param set-default SIM_GZ_SV_DIS2 182
param set-default SIM_GZ_SV_FUNC3 201
param set-default SIM_GZ_SV_MINA3 -25
param set-default SIM_GZ_SV_MAXA3 25
param set-default SIM_GZ_SV_FUNC4 202
param set-default SIM_GZ_SV_MINA4 -25
param set-default SIM_GZ_SV_MAXA4 25
param set-default SIM_GZ_SV_FUNC5 203
param set-default SIM_GZ_SV_MINA5 -25
param set-default SIM_GZ_SV_MAXA5 25
param set-default SIM_GZ_SV_FUNC6 204
param set-default SIM_GZ_SV_MINA6 -25
param set-default SIM_GZ_SV_MAXA6 25
param set-default SIM_GZ_SV_FUNC7 205
param set-default SIM_GZ_SV_MINA7 -25
param set-default SIM_GZ_SV_MAXA7 25
param set-default SIM_GZ_SV_FUNC8 206
param set-default SIM_GZ_SV_MINA8 -25
param set-default SIM_GZ_SV_MAXA8 25

# Transition and airspeeds (PX4_GUIDE.md; stall at CL 1.0, 35 C, AUW +10 %). The front
# transition ends 1 m/s above stall: held level, the wing carried the aircraft by ~15 m/s and
# the rotors unloaded, so a higher VT_ARSP_TRANS was never reached (REPORT.md, round 12).
param set-default VT_TILT_MC 0.18
param set-default VT_TILT_TRANS 0.55
param set-default VT_TILT_FW 1.0
param set-default FW_AIRSPD_STALL 13
param set-default FW_AIRSPD_MIN 16
param set-default FW_AIRSPD_TRIM 18
param set-default FW_AIRSPD_MAX 25
param set-default VT_ARSP_TRANS 14
param set-default VT_F_TRANS_DUR 8
# The front transition holds FW_PSP_OFF, the cruise attitude: this model's, rounded down. The
# lower it is, the further the speed where the wing takes the weight lies above VT_ARSP_TRANS.
param set-default FW_PSP_OFF -2
# Without a valid airspeed PX4 ends the transition after VT_F_TR_OL_TM (default 6 s; a
# tiltrotor also waits for its tilt ramp, VT_F_TRANS_DUR), and with one it gives up if the
# airspeed is still under VT_ARSP_BLEND then. Real props lose thrust as the speed builds.
param set-default VT_F_TR_OL_TM 12

# Quadchute (back to hover, then Return): fixed-wing pitch or roll past these, below 15 m, 15 m
# under the altitude setpoint, or 10 m lost in the front transition (PX4_GUIDE.md, Failsafes)
param set-default VT_FW_QC_P 35
param set-default VT_FW_QC_R 65
param set-default VT_FW_MIN_ALT 15
param set-default VT_QC_ALT_LOSS 15
param set-default VT_QC_T_ALT_LOSS 10

# Thrust curve: in this model thrust goes with the square of the motor command, which
# THR_MDL_FAC 0.90 undoes (the real one comes from a thrust stand). Hover and cruise are
# then fractions of full thrust. gz keeps a prop's thrust at any airspeed, so the real
# aircraft's cruise throttle is higher.
param set-default THR_MDL_FAC 0.90
param set-default MPC_THR_HOVER 0.48
param set-default FW_THR_TRIM 0.10

# Simulation only: the gz ESCs report no current, which PX4's ESC check reads as a failure
param set-default FD_ESCS_EN 0
